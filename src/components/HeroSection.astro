---
const base = import.meta.env.BASE_URL;
---

<section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden bg-charcoal">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-10">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="stone-grid" x="0" y="0" width="60" height="60" patternUnits="userSpaceOnUse">
          <path d="M 60 0 L 0 0 0 60" fill="none" stroke="#c4a882" stroke-width="1"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#stone-grid)" />
    </svg>
  </div>

  <!-- Decorative stone shapes -->
  <div class="absolute top-20 left-10 w-32 h-32 bg-stone/20 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 right-10 w-48 h-48 bg-stone/10 rounded-full blur-3xl"></div>

  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
    <p class="text-stone text-sm font-semibold uppercase tracking-widest mb-4">
      מאז 2005 — מובילים בתעשיית האבן
    </p>
    <h1 class="text-white text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black leading-tight mb-6">
      האבן הטבעית<br />
      <span class="text-stone">מגיעה אליכם</span>
    </h1>
    <p class="text-white/70 text-lg sm:text-xl max-w-2xl mx-auto mb-10 leading-relaxed">
      ארקופ מייבאת ומפיצה אבן טבעית ייחודית מרחבי העולם לפרויקטי יוקרה, בניה ועיצוב בישראל. איכות ללא פשרות, שירות אישי, מחיר הוגן.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={`${base}/our-stones`}
        class="inline-flex items-center justify-center gap-2 bg-stone text-charcoal font-bold px-8 py-4 rounded-lg hover:bg-stone/90 transition-colors text-lg shadow-xl"
      >
        גלה את האבנים שלנו
        <svg class="w-5 h-5 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a
        href={`${base}/contact`}
        class="inline-flex items-center justify-center gap-2 border-2 border-white/30 text-white font-semibold px-8 py-4 rounded-lg hover:border-stone hover:text-stone transition-colors text-lg"
      >
        צור קשר עכשיו
      </a>
    </div>

    <!-- Stats -->
    <div class="mt-16 grid grid-cols-3 gap-8 max-w-lg mx-auto">
      <div class="text-center">
        <p class="text-stone text-3xl font-black">20+</p>
        <p class="text-white/50 text-xs mt-1">שנות ניסיון</p>
      </div>
      <div class="text-center border-x border-white/10">
        <p class="text-stone text-3xl font-black">500+</p>
        <p class="text-white/50 text-xs mt-1">פרויקטים</p>
      </div>
      <div class="text-center">
        <p class="text-stone text-3xl font-black">25+</p>
        <p class="text-white/50 text-xs mt-1">גוונים של אבני גרנוליט וכדוריות זכוכית</p>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-white/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>
