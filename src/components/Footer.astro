---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="bg-charcoal text-white mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <!-- Brand -->
      <div>
        <h3 class="text-stone text-2xl font-black mb-3">ארקופ</h3>
        <p class="text-white/60 text-sm leading-relaxed">
          יבואן ומפיץ מוביל של אבן טבעית בישראל. משנת 2006 אנו מביאים את יופי האבן מרחבי העולם לפרויקטים ישראליים.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h4 class="text-white font-semibold mb-4">ניווט מהיר</h4>
        <ul class="space-y-2 text-sm">
          {[
            { href: `${base}/our-stones`, label: 'האבנים שלנו' },
            { href: `${base}/projects`, label: 'פרויקטים' },
            { href: `${base}/advantage`, label: 'יתרונות' },
            { href: `${base}/about`, label: 'אודות' },
            { href: `${base}/contact`, label: 'צור קשר' },
          ].map(({ href, label }) => (
            <li>
              <a href={href} class="text-white/60 hover:text-stone transition-colors">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-white font-semibold mb-4">יצירת קשר</h4>
        <ul class="space-y-3 text-sm text-white/60">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-stone shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>054-5233095</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-stone shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>arkop@netvision.net.il</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-white/10 text-center text-white/40 text-xs">
      © {new Date().getFullYear()} ארקופ בע"מ. כל הזכויות שמורות.
    </div>
  </div>
</footer>
