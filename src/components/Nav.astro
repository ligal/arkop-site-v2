---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === base || href === `${base}/`) {
    return currentPath === base || currentPath === `${base}/`;
  }
  return currentPath.startsWith(href);
}

const navLinks = [
  { href: `${base}/`, label: 'דף הבית' },
  { href: `${base}/our-stones`, label: 'האבנים שלנו' },
  { href: `${base}/projects`, label: 'פרויקטים' },
  { href: `${base}/advantage`, label: 'יתרונות' },
  { href: `${base}/about`, label: 'אודות' },
  { href: `${base}/contact`, label: 'צור קשר' },
];
---

<header class="sticky top-0 z-50 bg-charcoal/95 backdrop-blur-sm shadow-lg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href={`${base}/`} class="flex items-center gap-2 shrink-0">
        <span class="text-stone text-2xl font-black tracking-wide">ARKOP</span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class={`px-4 py-2 rounded-md text-sm font-medium transition-colors ${
              isActive(href)
                ? 'bg-stone text-charcoal'
                : 'text-white/80 hover:text-white hover:bg-white/10'
            }`}
          >
            {label}
          </a>
        ))}
      </nav>

      <!-- Mobile menu button -->
      <button
        id="menu-toggle"
        class="md:hidden p-2 rounded-md text-white/80 hover:text-white hover:bg-white/10 transition-colors"
        aria-label="פתח תפריט"
        aria-expanded="false"
      >
        <svg id="icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav id="mobile-menu" class="hidden md:hidden bg-charcoal border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 pb-4 pt-2 flex flex-col gap-1">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class={`px-4 py-2.5 rounded-md text-sm font-medium transition-colors ${
            isActive(href)
              ? 'bg-stone text-charcoal'
              : 'text-white/80 hover:text-white hover:bg-white/10'
          }`}
        >
          {label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
