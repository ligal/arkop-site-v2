---
interface Props {
  title: string;
  location: string;
  category: string;
  year: number;
  href: string;
  imageSrc?: string;
}

const { title, location, category, year, href, imageSrc } = Astro.props;
const base = import.meta.env.BASE_URL;
const baseWithSlash = base.endsWith('/') ? base : `${base}/`;
const normalizedImageSrc = imageSrc?.replace(/^\/+/, '');
---

<a
  href={href}
  class="group block bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1"
>
  <div class="aspect-video overflow-hidden bg-slate/10 relative">
    {imageSrc ? (
      <img
        src={`${baseWithSlash}${normalizedImageSrc}`}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-stone/20 to-stone/5">
        <svg class="w-16 h-16 text-stone/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
      </div>
    )}
    <div class="absolute top-3 start-3">
      <span class="bg-stone text-charcoal text-xs font-bold px-2 py-1 rounded">
        {category}
      </span>
    </div>
  </div>
  <div class="p-5">
    <h3 class="text-charcoal font-bold text-lg mb-1 group-hover:text-stone transition-colors">
      {title}
    </h3>
    <div class="flex items-center gap-3 text-sm text-slate">
      <span class="flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        </svg>
        {location}
      </span>
      <span>·</span>
      <span>{year}</span>
    </div>
  </div>
</a>
