<Base title="פרוייקטים" description="פרוייקטים שבוצעו בארץ ובחו״ל">
  <section class="relative overflow-hidden bg-[#072f2d] text-white">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,#8f2236_0%,transparent_45%)] opacity-60"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-16 text-center">
      <h1 class="text-4xl sm:text-5xl font-black">פרוייקטים</h1>
      <div class="w-24 h-1 rounded-full bg-[#8f2236] mx-auto mt-5"></div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-12 space-y-8">
    <section class="bg-white rounded-2xl border border-black/5 shadow-sm p-5 sm:p-7">
      <h2 class="text-[#072f2d] text-xl sm:text-2xl font-black mb-5">פרוייקטים שבוצעו בארץ:</h2>
      <ul class="list-disc list-inside marker:text-[#8f2236] space-y-2.5 text-charcoal leading-relaxed text-sm sm:text-base">
        {projectsInIsrael.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="bg-white rounded-2xl border border-black/5 shadow-sm p-5 sm:p-7">
      <h2 class="text-[#072f2d] text-xl sm:text-2xl font-black mb-5">פרוייקטים שבוצעו בחו״ל:</h2>
      <ul class="list-disc list-inside marker:text-[#8f2236] space-y-2.5 text-charcoal leading-relaxed text-sm sm:text-base">
        {projectsAbroad.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  </div>
</Base>
