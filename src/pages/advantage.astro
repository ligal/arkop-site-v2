---
import Base from '../layouts/Base.astro';

const advantages = [
  'מגוון רחב של גדלים, המאפשר חיפוי בעוביים שונים.',
  'עובי טיוח דק יחסית, המהווה פתרון אידיאלי לחיפוי משטחים קמורים וצורתיים.',
  'מגוון רחב של צבעים.',
  'מגוון רחב של סוגי אבנים: אבן טבעית, אבן זכוכית.',
  'אבנים מעודנות, מעוגלות או גרוסות, המקנות תחושה נעימה ויוקרתית.',
  'אפשרות יצירת תערובות אבן צבעוניות כיד הדמיון.',
  "שילוב עם כל סוגי החיפויים: אבן, עץ, קרמיקה, שיש, זכוכית וכד'.",
];
---

<Base title="יתרונות" description="למה לבחור בארקופ — יתרונות הייחודיים שלנו">
  <section class="relative overflow-hidden bg-[#072f2d] text-white">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,#8f2236_0%,transparent_45%)] opacity-60"></div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-14 sm:py-16 text-center">
      <h1 class="text-4xl sm:text-5xl font-black">היתרונות שלנו</h1>
      <div class="w-24 h-1 rounded-full bg-[#8f2236] mx-auto mt-5"></div>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {advantages.map((text, index) => (
        <div class="flex gap-5 p-7 bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow">
          <div class="shrink-0">
            <div class="w-12 h-12 bg-stone/15 rounded-xl flex items-center justify-center">
              <span class="text-stone/80 text-sm font-bold">{String(index + 1).padStart(2, '0')}</span>
            </div>
          </div>
          <div>
            <p class="text-charcoal text-base leading-relaxed font-medium">{text}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</Base>
