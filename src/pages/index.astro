---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
const baseWithSlash = base.endsWith('/') ? base : `${base}/`;
---

<Base title="דף הבית" description="ARKOP Fine Natural Stones - מראה מודרני המבוסס על זהות המותג">
  <section class="relative overflow-hidden bg-[#072f2d] text-white">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,#8f2236_0%,transparent_45%)] opacity-60"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-24">
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div class="text-center lg:text-right">
          <p class="inline-block text-xs tracking-[0.3em] uppercase bg-white/10 border border-white/20 rounded-full px-4 py-1 mb-5">
            יבוא ושיווק אבנים טבעיות
          </p>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black leading-tight mb-5">
            IT'S ALL ABOUT STYLE AND DESIGN
          </h1>
          <p class="text-white/75 text-lg max-w-xl mx-auto lg:mx-0 mb-8">
            FOR YOUR INTERIOR AND EXTERIOR NEEDS
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
            <a
              href={`${base}/our-stones`}
              class="inline-flex items-center justify-center px-7 py-3 rounded-lg bg-[#8f2236] font-semibold hover:bg-[#a1273e] transition-colors"
            >
              צפייה באבנים
            </a>
            <a
              href={`${base}/contact`}
              class="inline-flex items-center justify-center px-7 py-3 rounded-lg border border-white/30 hover:bg-white/10 transition-colors"
            >
              יצירת קשר
            </a>
          </div>
        </div>

        <div class="rounded-2xl bg-white p-4 sm:p-6 shadow-2xl">
          <img
            src={`${baseWithSlash}images/brand/arkop-logo-legacy.png`}
            alt="ARKOP Fine Natural Stones"
            class="w-full h-auto rounded-xl"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white border-y border-black/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <p class="text-3xl font-black text-[#072f2d]">20+</p>
          <p class="text-slate text-sm mt-1">שנות ניסיון</p>
        </div>
        <div>
          <p class="text-3xl font-black text-[#8f2236]">500+</p>
          <p class="text-slate text-sm mt-1">פרויקטים</p>
        </div>
        <div>
          <p class="text-3xl font-black text-[#072f2d]">50+</p>
          <p class="text-slate text-sm mt-1">סוגי אבן</p>
        </div>
        <div>
          <p class="text-3xl font-black text-[#8f2236]">100%</p>
          <p class="text-slate text-sm mt-1">שירות אישי</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-gradient-to-r from-[#8f2236] to-[#072f2d]">
    <div class="max-w-4xl mx-auto px-4 text-center text-white">
      <h2 class="text-3xl sm:text-4xl font-black mb-4">מוכנים לפרויקט הבא?</h2>
      <p class="text-white/80 text-lg mb-8 max-w-xl mx-auto">
        נשמח לבנות איתכם קונספט חומרי מדויק — מהבחירה ועד הביצוע.
      </p>
      <a
        href={`${base}/contact`}
        class="inline-flex items-center justify-center gap-2 bg-white text-[#072f2d] font-bold px-10 py-4 rounded-lg hover:bg-white/90 transition-colors text-lg shadow-xl"
      >
        צור קשר עכשיו
      </a>
    </div>
  </section>
</Base>
