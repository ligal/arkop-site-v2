---
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import { getEntry } from 'astro:content';

const stone = await getEntry('stones', 'natural');
const base = import.meta.env.BASE_URL;
const shortCaptionByImage: Record<string, string> = {
  'ycc_007.JPG': 'YSF-050 ירוק בהיר',
  'ycd_005.JPG': 'YSF-003 חלוקי נחל חומים',
  'ycd_018.JPG': "YSF-006 חום בז'",
  'yce_001.JPG': 'YSF-001 ירוק כהה',
  'yce_006.JPG': 'YSF-015 אפור כהה',
  'yce_007.jpg': 'YSF-008 לבן אפרפר',
  'yce_009.JPG': 'YSF-049 שחור',
  'yce_011.jpg': 'YSF-051 חום כתום',
  'yce_012.jpg': 'YSF-020 בורדו בהיר',
  'yce_014.JPG': 'YSF-041 לבן חלב',
  'yce_015.JPG': 'YSF-047 אפור בהיר',
  'yce_018.JPG': 'YSF-013 חלוקי נחל אפורים'
};
const detailedCaptionByImage: Record<string, string> = {
  'ycc_007.JPG': 'YSF-050 ירוק בהיר',
  'ycd_005.JPG': 'YSF-003 חלוקי נחל חומים גדלים: 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ',
  'ycd_018.JPG': "YSF-006 חום בז' גדלים: 1.5-3 מ\"מ, 3-6 מ\"מ, 6-9 מ\"מ, 9-12 מ\"מ",
  'yce_001.JPG': 'YSF-001 ירוק כהה גדלים: 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ',
  'yce_006.JPG': 'YSF-015 אפור כהה גדלים: 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ',
  'yce_007.jpg': 'YSF-008 לבן אפרפר גדלים: 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ',
  'yce_009.JPG': 'YSF-049 שחור גדלים: 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ',
  'yce_011.jpg': 'YSF-051 חום כתום גדלים: 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ',
  'yce_012.jpg': 'YSF-020 בורדו בהיר גדלים: 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ',
  'yce_014.JPG': 'YSF-041 לבן חלב גדלים: 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ',
  'yce_015.JPG': 'YSF-047 אפור בהיר גדלים: 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ',
  'yce_018.JPG': 'YSF-013 חלוקי נחל אפורים גדלים: 3-6 מ"מ, 9-12 מ"מ'
};
const shortCaptions = stone.data.images.map((img) => shortCaptionByImage[img] ?? img);
const detailedCaptions = stone.data.images.map((img) => detailedCaptionByImage[img] ?? img);
---

<Base title={stone.data.title} description={stone.data.description}>
  <div class="bg-charcoal/5 border-b border-charcoal/10 py-3">
    <div class="max-w-5xl mx-auto px-4 flex items-center gap-2 text-sm text-slate">
      <a href={`${base}/`} class="hover:text-stone transition-colors">דף הבית</a>
      <svg class="w-4 h-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <a href={`${base}/our-stones`} class="hover:text-stone transition-colors">האבנים שלנו</a>
      <svg class="w-4 h-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-charcoal font-medium">{stone.data.title}</span>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2">
        <h1 class="text-charcoal text-3xl sm:text-4xl font-black mb-4">{stone.data.title}</h1>
        <p class="text-slate text-lg leading-relaxed mb-8">{stone.data.description}</p>
        {stone.data.images.length > 0 && (
          <div>
            <h2 class="text-charcoal font-black text-xl mb-4">גלריה</h2>
            <Gallery
              images={stone.data.images}
              basePath="images/stones/natural"
              title={stone.data.title}
              captions={shortCaptions}
              lightboxCaptions={detailedCaptions}
            />
          </div>
        )}
      </div>
      <div class="lg:col-span-1">
        <div class="bg-charcoal text-white rounded-xl p-6 sticky top-24">
          <h3 class="font-bold text-lg mb-3">מעוניינים ב{stone.data.title}?</h3>
          <p class="text-white/60 text-sm mb-5 leading-relaxed">צרו קשר לקבלת מידע על מחירים, מלאי וזמני אספקה</p>
          <a href={`${base}/contact`} class="block w-full bg-stone text-charcoal text-center font-bold py-3 rounded-lg hover:bg-stone/90 transition-colors">
            קבל הצעת מחיר
          </a>
          <a href="tel:0545233095" class="block w-full border border-white/20 text-white text-center font-medium py-3 rounded-lg hover:border-white/50 transition-colors mt-3 text-sm">
            התקשר: 054-5233095
          </a>
        </div>
      </div>
    </div>
  </div>
</Base>
