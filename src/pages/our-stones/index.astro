---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const baseWithSlash = base.endsWith('/') ? base : `${base}/`;
---

<Base title="האבנים שלנו" description="האבנים שלנו - כמו באתר המורשת">
  <section class="relative overflow-hidden bg-[#072f2d] text-white">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,#8f2236_0%,transparent_45%)] opacity-60"></div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-14 sm:py-16 text-center">
      <h1 class="text-4xl sm:text-5xl font-black">האבנים שלנו</h1>
      <div class="w-24 h-1 rounded-full bg-[#8f2236] mx-auto mt-5"></div>
    </div>
  </section>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 sm:py-14">

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <a
        class="group block text-center rounded-xl bg-white p-3 shadow-sm border border-black/5 hover:shadow-md transition-all duration-300"
        href={`${base}/our-stones/natural`}
      >
        <img
          class="w-full aspect-[4/3] object-cover rounded-lg border border-black/10 group-hover:scale-[1.02] transition-transform duration-300"
          src={`${baseWithSlash}images/stones/covers/natural.jpg`}
          alt="אבנים טבעיות"
        />
        <h2 class="mt-3 text-lg font-bold text-charcoal">אבנים טבעיות</h2>
      </a>

      <a
        class="group block text-center rounded-xl bg-white p-3 shadow-sm border border-black/5 hover:shadow-md transition-all duration-300"
        href={`${base}/our-stones/glasses`}
      >
        <img
          class="w-full aspect-[4/3] object-cover rounded-lg border border-black/10 group-hover:scale-[1.02] transition-transform duration-300"
          src={`${baseWithSlash}images/stones/covers/glasses.jpg`}
          alt="זכוכיות מעוגלות"
        />
        <h2 class="mt-3 text-lg font-bold text-charcoal">זכוכיות מעוגלות</h2>
      </a>

      <a
        class="group block text-center rounded-xl bg-white p-3 shadow-sm border border-black/5 hover:shadow-md transition-all duration-300"
        href={`${base}/our-stones/ground-glasses`}
      >
        <img
          class="w-full aspect-[4/3] object-cover rounded-lg border border-black/10 group-hover:scale-[1.02] transition-transform duration-300"
          src={`${baseWithSlash}images/stones/covers/ground-glasses.jpg`}
          alt="זכוכיות גרוסות"
        />
        <h2 class="mt-3 text-lg font-bold text-charcoal">זכוכיות גרוסות</h2>
      </a>
    </div>

    <div class="mt-8 max-w-[260px] mx-auto">
      <a
        class="group block text-center rounded-xl bg-white p-3 shadow-sm border border-black/5 hover:shadow-md transition-all duration-300"
        href={`${base}/our-stones/mishtachim`}
      >
        <img
          class="w-full aspect-[4/3] object-cover rounded-lg border border-black/10 group-hover:scale-[1.02] transition-transform duration-300"
          src={`${baseWithSlash}images/stones/covers/mishtachim.jpg`}
          alt="דוגמאות ליציקות גרנוליט"
        />
        <h2 class="mt-3 text-lg font-bold text-charcoal">דוגמאות ליציקות גרנוליט</h2>
      </a>
    </div>
  </div>
</Base>
