---
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import { getEntry } from 'astro:content';

const stone = await getEntry('stones', 'glasses');
const base = import.meta.env.BASE_URL;
const shortCaptionByImage: Record<string, string> = {
  'ycf_012_1.JPG': 'Jade Green',
  'Apple Green.JPG': 'Apple Green',
  'glass_light_green.JPG': 'Light Green',
  'ycf_012_2.JPG': 'Amber Brown',
  'ycf_012_3.JPG': 'Crystal White',
  'glass_pearl_black.JPG': 'Pearle Black',
  'Clear Black.JPG': 'Clear Black',
  'ycf_012_5.JPG': 'Sapphire Blue',
  'glass_azure_blue.JPG': 'Azure Blue',
  'ycf_012_7.JPG': 'Ocean Blue',
  'ycf_012_8.JPG': 'Amethyst Purple',
  'ycf_012_10.JPG': 'Crystal Yellow',
  'Clear Yellow.JPG': 'Clear Yellow',
  'ycf_012_11.JPG': 'Crystal Red',
  'Pink.JPG': 'Pink',
  'ycf_012_12.JPG': 'Crystal Orange',
  'glass_bronze.JPG': 'Bronze'
};
const detailedCaptionByImage: Record<string, string> = {
  'ycf_012_1.JPG': 'Jade Green גדלים: 0.6-1.5 מ"מ, 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ, 12+ מ"מ',
  'Apple Green.JPG': 'Apple Green גדלים: 0.6-1.5 מ"מ, 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ, 12+ מ"מ',
  'glass_light_green.JPG': 'Light Green גדלים: 0.6-1.5 מ"מ, 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ, 12+ מ"מ',
  'ycf_012_2.JPG': 'Amber Brown גדלים: 0.6-1.5 מ"מ, 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ, 12+ מ"מ',
  'ycf_012_3.JPG': 'Crystal White גדלים: 0.6-1.5 מ"מ, 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ, 12+ מ"מ',
  'glass_pearl_black.JPG': 'Pearle Black גדלים: 0.6-1.5 מ"מ, 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ, 12+ מ"מ',
  'Clear Black.JPG': 'Clear Black גדלים: 0.6-1.5 מ"מ, 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ, 12+ מ"מ',
  'ycf_012_5.JPG': 'Sapphire Blue גדלים: 0.6-1.5 מ"מ, 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ, 12+ מ"מ',
  'glass_azure_blue.JPG': 'Azure Blue גדלים: 0.6-1.5 מ"מ, 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ, 12+ מ"מ',
  'ycf_012_7.JPG': 'Ocean Blue גדלים: 0.6-1.5 מ"מ, 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ, 12+ מ"מ',
  'ycf_012_8.JPG': 'Amethyst Purple גדלים: 0.6-1.5 מ"מ, 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ, 12+ מ"מ',
  'ycf_012_10.JPG': 'Crystal Yellow גדלים: 0.6-1.5 מ"מ, 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ, 12+ מ"מ',
  'Clear Yellow.JPG': 'Clear Yellow גדלים: 0.6-1.5 מ"מ, 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ, 12+ מ"מ',
  'ycf_012_11.JPG': 'Crystal Red גדלים: 0.6-1.5 מ"מ, 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ, 12+ מ"מ',
  'Pink.JPG': 'Pink גדלים: 0.6-1.5 מ"מ, 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ, 12+ מ"מ',
  'ycf_012_12.JPG': 'Crystal Orange גדלים: 0.6-1.5 מ"מ, 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ, 12+ מ"מ',
  'glass_bronze.JPG': 'Bronze גדלים: 0.6-1.5 מ"מ, 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ, 12+ מ"מ'
};
const shortCaptions = stone.data.images.map((img) => shortCaptionByImage[img] ?? img);
const detailedCaptions = stone.data.images.map((img) => detailedCaptionByImage[img] ?? img);
---

<Base title={stone.data.title} description={stone.data.description}>
  <div class="bg-charcoal/5 border-b border-charcoal/10 py-3">
    <div class="max-w-5xl mx-auto px-4 flex items-center gap-2 text-sm text-slate">
      <a href={`${base}/`} class="hover:text-stone transition-colors">דף הבית</a>
      <svg class="w-4 h-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <a href={`${base}/our-stones`} class="hover:text-stone transition-colors">האבנים שלנו</a>
      <svg class="w-4 h-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-charcoal font-medium">{stone.data.title}</span>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2">
        <h1 class="text-charcoal text-3xl sm:text-4xl font-black mb-4">{stone.data.title}</h1>
        <p class="text-slate text-lg leading-relaxed mb-8">{stone.data.description}</p>
        {stone.data.images.length > 0 && (
          <div>
            <h2 class="text-charcoal font-black text-xl mb-4">גלריה</h2>
            <Gallery
              images={stone.data.images}
              basePath="images/stones/glasses"
              title={stone.data.title}
              captions={shortCaptions}
              lightboxCaptions={detailedCaptions}
            />
          </div>
        )}
      </div>
      <div class="lg:col-span-1">
        <div class="bg-charcoal text-white rounded-xl p-6 sticky top-24">
          <h3 class="font-bold text-lg mb-3">מעוניינים ב{stone.data.title}?</h3>
          <p class="text-white/60 text-sm mb-5 leading-relaxed">צרו קשר לקבלת מידע על מחירים, מלאי וזמני אספקה</p>
          <a href={`${base}/contact`} class="block w-full bg-stone text-charcoal text-center font-bold py-3 rounded-lg hover:bg-stone/90 transition-colors">
            קבל הצעת מחיר
          </a>
          <a href="tel:0545233095" class="block w-full border border-white/20 text-white text-center font-medium py-3 rounded-lg hover:border-white/50 transition-colors mt-3 text-sm">
            התקשר: 054-5233095
          </a>
        </div>
      </div>
    </div>
  </div>
</Base>
