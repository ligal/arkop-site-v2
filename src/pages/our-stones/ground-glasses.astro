---
import Base from '../../layouts/Base.astro';
import { getEntry } from 'astro:content';

const stone = await getEntry('stones', 'ground-glasses');
const base = import.meta.env.BASE_URL;
const baseWithSlash = base.endsWith('/') ? base : `${base}/`;
const shortCaptionByImage: Record<string, string> = {
  'Jade Green_b.JPG': 'Jade Green (b)',
  'Light Green_b.JPG': 'Light Green (b)',
  'Amber Brown_b.JPG': 'Amber Brown (b)',
  'Amethyst Purple_b.JPG': 'Amethyst Purple (b)',
  'Bronze_b.JPG': 'Bronze (b)',
  'Clear White_b.JPG': 'Clear White (b)',
  'Crystal Yellow_b.JPG': 'Crystal Yellow (b)',
  'Ocean Blue_b.JPG': 'Ocean Blue (b)',
  'Sapphire Blue_b.JPG': 'Sapphire Blue (b)',
  'Azure Blue_b.JPG': 'Azure Blue (b)'
};
const detailedCaptionByImage: Record<string, string> = {
  'Jade Green_b.JPG': 'Jade Green (b)\nגדלים: 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ',
  'Light Green_b.JPG': 'Light Green (b)\nגדלים: 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ',
  'Amber Brown_b.JPG': 'Amber Brown (b)\nגדלים: 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ',
  'Amethyst Purple_b.JPG': 'Amethyst Purple (b)\nגדלים: 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ',
  'Bronze_b.JPG': 'Bronze (b)\nגדלים: 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ',
  'Clear White_b.JPG': 'Clear White (b)\nגדלים: 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ',
  'Crystal Yellow_b.JPG': 'Crystal Yellow (b)\nגדלים: 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ',
  'Ocean Blue_b.JPG': 'Ocean Blue (b)\nגדלים: 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ',
  'Sapphire Blue_b.JPG': 'Sapphire Blue (b)\nגדלים: 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ',
  'Azure Blue_b.JPG': 'Azure Blue (b)\nגדלים: 1.5-3 מ"מ, 3-6 מ"מ, 6-9 מ"מ, 9-12 מ"מ'
};
const shortCaptions = stone.data.images.map((img) => shortCaptionByImage[img] ?? img);
const detailedCaptions = stone.data.images.map((img) => detailedCaptionByImage[img] ?? img);
---

<Base title={stone.data.title} description={stone.data.description}>
  <div class="bg-charcoal/5 border-b border-charcoal/10 py-3">
    <div class="max-w-5xl mx-auto px-4 flex items-center gap-2 text-sm text-slate">
      <a href={`${base}/`} class="hover:text-stone transition-colors">דף הבית</a>
      <svg class="w-4 h-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <a href={`${base}/our-stones`} class="hover:text-stone transition-colors">האבנים שלנו</a>
      <svg class="w-4 h-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-charcoal font-medium">{stone.data.title}</span>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div>
      <div>
        <h1 class="text-charcoal text-3xl sm:text-4xl font-black mb-4">{stone.data.title}</h1>
        <p class="text-slate text-lg leading-relaxed mb-8">{stone.data.description}</p>
        {stone.data.images.length > 0 && (
          <div>
            <h2 class="text-charcoal font-black text-xl mb-4">גלריה</h2>
            <div class="grid grid-cols-1 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] gap-4 items-start">
              <div class="bg-white rounded-2xl border border-black/10 p-3 sm:p-4">
                <div class="aspect-[4/3] rounded-xl overflow-hidden bg-slate/10">
                  <img
                    id="ground-focus-image"
                    src={`${baseWithSlash}images/stones/ground-glasses/${stone.data.images[0]}`}
                    alt={stone.data.title}
                    class="w-full h-full object-cover"
                  />
                </div>
                <p id="ground-focus-caption" class="mt-3 text-sm sm:text-base font-semibold text-charcoal text-center whitespace-pre-line">
                  {detailedCaptions[0]}
                </p>
              </div>

              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-2 gap-3">
                {stone.data.images.map((img, i) => (
                  <button
                    class={`ground-thumb group relative aspect-square overflow-hidden rounded-lg bg-slate/10 transition-all w-full ${
                      i === 0 ? 'ring-2 ring-[#8f2236]' : 'hover:opacity-95'
                    }`}
                    data-src={`${baseWithSlash}images/stones/ground-glasses/${img}`}
                    data-detailed={detailedCaptions[i]}
                    type="button"
                  >
                    <img
                      src={`${baseWithSlash}images/stones/ground-glasses/${img}`}
                      alt={`${stone.data.title} — תמונה ${i + 1}`}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                    <div class="absolute inset-x-0 bottom-0 bg-black/65 backdrop-blur-[1px] px-2 py-1 text-center text-white text-xs font-semibold leading-tight">
                      {shortCaptions[i]}
                    </div>
                  </button>
                ))}
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</Base>

<script>
  const focusImage = document.getElementById('ground-focus-image') as HTMLImageElement | null;
  const focusCaption = document.getElementById('ground-focus-caption');
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.ground-thumb');

  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      if (!focusImage || !focusCaption) return;
      const src = thumb.getAttribute('data-src') || '';
      const detailed = thumb.getAttribute('data-detailed') || '';
      focusImage.src = src;
      focusCaption.textContent = detailed;

      thumbs.forEach((btn) => {
        btn.classList.remove('ring-2', 'ring-[#8f2236]');
        btn.classList.add('hover:opacity-95');
      });
      thumb.classList.add('ring-2', 'ring-[#8f2236]');
      thumb.classList.remove('hover:opacity-95');
    });
  });
</script>
