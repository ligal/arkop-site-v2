---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="צור קשר" description="צרו קשר עם ארקופ — נשמח לענות על שאלות ולספק הצעת מחיר">
  <!-- Page hero -->
  <div class="bg-charcoal text-white py-20 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-stone font-semibold uppercase tracking-widest text-sm mb-3">דברו איתנו</p>
      <h1 class="text-4xl sm:text-5xl font-black mb-4">צור קשר</h1>
      <p class="text-white/60 text-lg max-w-2xl mx-auto">
        נשמח לענות על כל שאלה, לסייע בבחירת האבן המתאימה ולספק הצעת מחיר מותאמת אישית
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <!-- Contact form -->
      <div>
        <h2 class="text-charcoal text-2xl font-black mb-6">שלחו לנו הודעה</h2>
        <form
          class="space-y-5"
          id="contact-form"
          novalidate
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-semibold text-charcoal mb-1.5">שם מלא *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full border border-charcoal/20 rounded-lg px-4 py-3 text-charcoal placeholder-slate/50 focus:outline-none focus:border-stone focus:ring-1 focus:ring-stone transition-colors"
                placeholder="ישראל ישראלי"
              />
            </div>
            <div>
              <label for="phone" class="block text-sm font-semibold text-charcoal mb-1.5">טלפון *</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                class="w-full border border-charcoal/20 rounded-lg px-4 py-3 text-charcoal placeholder-slate/50 focus:outline-none focus:border-stone focus:ring-1 focus:ring-stone transition-colors"
                placeholder="050-000-0000"
                dir="ltr"
              />
            </div>
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-charcoal mb-1.5">דואר אלקטרוני</label>
            <input
              type="email"
              id="email"
              name="email"
              class="w-full border border-charcoal/20 rounded-lg px-4 py-3 text-charcoal placeholder-slate/50 focus:outline-none focus:border-stone focus:ring-1 focus:ring-stone transition-colors"
              placeholder="example@email.com"
              dir="ltr"
            />
          </div>

          <div>
            <label for="subject" class="block text-sm font-semibold text-charcoal mb-1.5">נושא</label>
            <select
              id="subject"
              name="subject"
              class="w-full border border-charcoal/20 rounded-lg px-4 py-3 text-charcoal focus:outline-none focus:border-stone focus:ring-1 focus:ring-stone transition-colors bg-white"
            >
              <option value="">בחרו נושא...</option>
              <option value="quote">בקשת הצעת מחיר</option>
              <option value="stones">שאלה על מוצר</option>
              <option value="project">ייעוץ לפרויקט</option>
              <option value="order">מעקב הזמנה</option>
              <option value="other">אחר</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-charcoal mb-1.5">הודעה *</label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              class="w-full border border-charcoal/20 rounded-lg px-4 py-3 text-charcoal placeholder-slate/50 focus:outline-none focus:border-stone focus:ring-1 focus:ring-stone transition-colors resize-none"
              placeholder="ספרו לנו על הפרויקט שלכם..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-charcoal text-white font-bold py-4 rounded-lg hover:bg-charcoal/90 transition-colors text-lg"
          >
            שלח הודעה
          </button>

          <div id="form-success" class="hidden bg-stone/10 border border-stone/30 text-stone rounded-lg p-4 text-center font-semibold">
            תודה! ההודעה נשלחה. נחזור אליכם בהקדם האפשרי.
          </div>
        </form>
      </div>

      <!-- Contact info -->
      <div>
        <h2 class="text-charcoal text-2xl font-black mb-6">פרטי התקשרות</h2>

        <div class="space-y-6 mb-10">
          {[
            {
              icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
              title: 'טלפון',
              value: '03-000-0000',
              href: 'tel:030000000',
              dir: 'ltr',
            },
            {
              icon: 'M12 18h.01M8 21h8a2 2 0 002-2v-1a4 4 0 00-4-4H8a4 4 0 00-4 4v1a2 2 0 002 2zm5-13a4 4 0 11-8 0 4 4 0 018 0z',
              title: 'נייד',
              value: '050-000-0000',
              href: 'tel:0500000000',
              dir: 'ltr',
            },
            {
              icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
              title: 'דואר אלקטרוני',
              value: 'info@arkop.co.il',
              href: 'mailto:info@arkop.co.il',
              dir: 'ltr',
            },
            {
              icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z',
              title: 'כתובת',
              value: 'רחוב התעשיה 1, אזור תעשייה, ישראל',
              href: null,
              dir: 'rtl',
            },
          ].map(({ icon, title, value, href, dir }) => (
            <div class="flex gap-4">
              <div class="w-11 h-11 bg-stone/15 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-stone" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={icon} />
                </svg>
              </div>
              <div>
                <p class="text-slate text-xs font-semibold uppercase tracking-wide mb-1">{title}</p>
                {href ? (
                  <a href={href} dir={dir} class="text-charcoal font-medium hover:text-stone transition-colors">
                    {value}
                  </a>
                ) : (
                  <p class="text-charcoal font-medium">{value}</p>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- Business hours -->
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <h3 class="text-charcoal font-bold mb-4">שעות פעילות</h3>
          <ul class="space-y-2 text-sm">
            <li class="flex justify-between">
              <span class="text-slate">ראשון — חמישי</span>
              <span class="text-charcoal font-medium" dir="ltr">08:00 – 17:00</span>
            </li>
            <li class="flex justify-between">
              <span class="text-slate">שישי</span>
              <span class="text-charcoal font-medium" dir="ltr">08:00 – 13:00</span>
            </li>
            <li class="flex justify-between">
              <span class="text-slate">שבת</span>
              <span class="text-slate">סגור</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('form-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    success?.classList.remove('hidden');
    form.reset();
    setTimeout(() => success?.classList.add('hidden'), 6000);
  });
</script>
